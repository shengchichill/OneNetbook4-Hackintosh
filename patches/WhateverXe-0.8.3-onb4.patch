+// ONB4 ⑦: S3 喚醒 eDP 黑屏診斷。只在 Apple 自己正在存取顯示暫存器的時間點
+// （hwEnableInterrupts 後、hwSetPanelPower 前後、linkTraining 前後）讀取，不寫入。
+// 前 64 筆固定保留（開機），之後 192 筆環狀覆寫（最近的喚醒）。ioreg 讀取時才序列化。
+// tag: 1=EnableIRQ 後（修正前） 2=HPD 修正後(arg=修正前的 0xC4030) 3/4=SetPanelPower 進/出(arg=state)
+//      8/9=enableComboPhy 進/出(arg=ddi | 修正前 COMP_DW8<<8 的 bit24 旗標)
+//      5/6=linkTraining 進/出(arg=ddi / result) 7=setVoltageSwing 出(arg=path<<16|swing<<8|emphasis, path 1=WEX combo)
+static constexpr uint32_t onb4WakeRegs[40] {
+ 0xC4000,0xC4004,0xC400C,0xC4030,0xC4034,0xC4038,  // SDEISR/IMR/IER, SHOTPLUG_CTL_DDI/TC, SHPD_FILTER_CNT
+ 0xC7200,0xC7204,0xC7208,0xC720C,                  // PP_STATUS/CONTROL/ON/OFF
+ 0x45400,0x45404,0x45444,0x45504,0x46000,0x164280, // PWR_WELL_CTL1/2, AUX2, DC_STATE_EN, CDCLK_CTL, DPCLKA_CFGCR0
+ 0x64000,0x60400,0x60540,0x60544,                  // DDI_BUF_CTL_A, TRANS_DDI_FUNC_CTL_A, DP_TP_CTL_A/STATUS_A
+ 0x162014,0x162100,0x16210C,0x64C00,               // PORT_CL_DW5_A, PORT_COMP_DW0/DW3_A, PHY_MISC_A
+ 0x45454,0x162028,0x162804,                        // PWR_WELL_CTL_DDI2, PORT_CL_DW10_A, PORT_PCS_DW1_LN0_A
+ 0x162888,0x162890,0x162894,0x16289C,              // PORT_TX_DW2/4/5/7 LN0
+ 0x162988,0x162990,0x162994,0x16299C,              // PORT_TX_DW2/4/5/7 LN1
+ 0x162120,                                         // PORT_COMP_DW8_A（IREFGEN = bit24）
+ 0x1628A0,0x1629A0,0x162904,0x162AA0};             // ⑨ PORT_TX_DW8 LN0/LN1、PCS_DW1_LN1、TX_DW8_LN2
+struct ONB4WakeSnap {uint64_t ns;uint32_t tag,arg;uint32_t r[40];};
+static volatile uint32_t onb4WakeCount;
+static ONB4WakeSnap onb4WakeSnaps[256];
+static bool onb4HPDFixEnabled,onb4IREFFixEnabled,onb4DCCFixEnabled,onb4Lane4Enabled,onb4TPS3Enabled;
+static bool onb4LTRetry; // ⑳ -onb4ltretry：DDI A link training 失敗時整輪重做（最多 4 次）
+static uint32_t onb4LTRetryStat[4]; // 重試次數、救回次數、用盡次數、最近一次成功的嘗試序號
+static bool onb4HBR; // ⑲ -onb4hbr：DDI A（eDP）sink 最大速率壓到 HBR 0x0A（2.7 Gbps）
+static bool onb4DCCLinux; // ⑱ -onb4dcclinux：⑨ 一律用 Linux 值（ODCC_CLK_SEL|DIV2、RUN_DCC_ONCE），不還原 GOP 值
+static uint32_t onb4HPDFixes,onb4IREFFixes,onb4DCCFixes,onb4Lane4Fixes;
+static uint32_t onb4TPSState; // ⑪ bits7:0 = 最近一次 port+0xFB（TPS4）原值、15:8 = port+0x12（TPS3）、31:16 = 改成 TPS3 的次數
+// ⑨ 開機（GOP 設好、尚未 S3）時 PHY A 四個 lane 的 PORT_TX_DW8 與 PORT_PCS_DW1，喚醒時還原 ODCC/DCC 欄位。
+static uint32_t onb4BootTXDW8[4],onb4BootPCSDW1[4],onb4BootSaved;
+static volatile uint8_t *onb4LiveBase;static uint32_t onb4LiveSize; // ⑰：最近一次 onb4WakeSnap 看到的 MMIO map
+static constexpr uint32_t onb4LaneTXDW8(unsigned ln) {return 0x1628A0+ln*0x100;}
+static constexpr uint32_t onb4LanePCSDW1(unsigned ln) {return 0x162804+ln*0x100;}
+static void onb4WakeSnap(void *access,uint32_t tag,uint32_t arg) {
+ auto a=static_cast<uint8_t *>(access);if(!a)return;
+ auto base=*reinterpret_cast<volatile uint8_t **>(a+0x50);
+ const auto size=*reinterpret_cast<uint32_t *>(a+0x60);
+ if(!base || size<0x165000)return;
+ onb4LiveBase=base;onb4LiveSize=size; // ⑰ ONB4LiveRegs 用（只讀）
+ if(tag==1 && !__atomic_load_n(&onb4BootSaved,__ATOMIC_ACQUIRE)) {
+  // 第一次 EnableIRQ 在開機時、Apple 尚未重設 PHY；值看起來有效才記錄。
+  uint32_t dw8[4],pcs[4];bool ok=true;
+  for(unsigned l=0;l<4;++l){
+   dw8[l]=*reinterpret_cast<volatile uint32_t *>(base+onb4LaneTXDW8(l));
+   pcs[l]=*reinterpret_cast<volatile uint32_t *>(base+onb4LanePCSDW1(l));
+   if(dw8[l]==~0U || pcs[l]==~0U)ok=false;
+  }
+  if(ok && (dw8[0]|pcs[0])){memcpy(onb4BootTXDW8,dw8,sizeof(dw8));memcpy(onb4BootPCSDW1,pcs,sizeof(pcs));__atomic_store_n(&onb4BootSaved,1,__ATOMIC_RELEASE);}
+ }
+ const auto n=__sync_fetch_and_add(&onb4WakeCount,1);
+ auto &s=onb4WakeSnaps[n<64?n:64+(n-64)%192];
+ uint64_t t;clock_get_uptime(&t);absolutetime_to_nanoseconds(t,&s.ns);
+ s.tag=tag;s.arg=arg;
+ for(unsigned i=0;i<40;++i)s.r[i]=*reinterpret_cast<volatile uint32_t *>(base+onb4WakeRegs[i]);
+}
+// ONB4 ⑫: linkTraining 出口整段 dump（跟 Linux tools/onb4-linux-regdump.sh 同範圍），找取樣以外的差異。
+// slot 0 = 第一次成功、1 = 第一次失敗、2 = 最近一次（任何結果）。只讀。
+static constexpr uint32_t onb4DumpRanges[][2] {
+ {0x162000,96},{0x162800,64},{0x162900,64},{0x162A00,64},{0x162B00,64}, // PHY A CL/COMP、LN0..3
+ {0x164200,64},{0x46000,8},{0x46010,8},                                   // DPCLKA/DPLL CFGCR、CDCLK、DPLL_ENABLE
+ {0x60000,32},{0x60400,4},{0x60500,24},{0x64000,4},{0x64C00,4},           // TRANS A timing/M/N、DDI_FUNC、DP_TP、DDI_BUF、PHY_MISC
+ {0x45400,8},{0x45440,8},{0x45500,4},{0xC7200,4},{0xC4000,16}};          // power wells、AUX/DDI wells、DC_STATE、PPS、SDE
+static constexpr uint32_t onb4DumpWords() {uint32_t n=0;for(auto &r:onb4DumpRanges)n+=r[1];return n;}
+struct ONB4PhyDump {uint64_t ns;uint32_t valid,result,seq,pad;uint32_t w[onb4DumpWords()];};
+static ONB4PhyDump onb4PhyDumps[3];
+static uint32_t onb4PhyDumpSeq;
+static void onb4PhyDump(void *access,uint32_t result) {
+ auto a=static_cast<uint8_t *>(access);if(!a)return;
+ auto base=*reinterpret_cast<volatile uint8_t **>(a+0x50);
+ const auto size=*reinterpret_cast<uint32_t *>(a+0x60);
+ if(!base || size<0x165000)return;
+ const auto seq=__sync_add_and_fetch(&onb4PhyDumpSeq,1);
+ auto fill=[&](ONB4PhyDump &d){
+  uint64_t t;clock_get_uptime(&t);absolutetime_to_nanoseconds(t,&d.ns);
+  d.result=result;d.seq=seq;unsigned k=0;
+  for(auto &r:onb4DumpRanges)for(uint32_t i=0;i<r[1];++i)d.w[k++]=*reinterpret_cast<volatile uint32_t *>(base+r[0]+4*i);
+  __atomic_store_n(&d.valid,1,__ATOMIC_RELEASE);
+ };
+ if(result==0 && !onb4PhyDumps[0].valid)fill(onb4PhyDumps[0]);
+ if(result!=0 && !onb4PhyDumps[1].valid)fill(onb4PhyDumps[1]);
+ fill(onb4PhyDumps[2]);
+}
+static bool onb4PhyDumpSerialize(void *,void *,OSSerialize *serializer) {
+ auto data=OSData::withCapacity(16+sizeof(onb4DumpRanges)+sizeof(onb4PhyDumps));if(!data)return false;
+ uint32_t head[4]={1,uint32_t(sizeof(onb4DumpRanges)/sizeof(onb4DumpRanges[0])),onb4DumpWords(),onb4PhyDumpSeq};
+ data->appendBytes(head,sizeof(head));data->appendBytes(onb4DumpRanges,sizeof(onb4DumpRanges));
+ data->appendBytes(onb4PhyDumps,sizeof(onb4PhyDumps));
+ const bool ok=data->serialize(serializer);data->release();return ok;
+}
+// ⑭：DDI A 每筆 RunAUX（Apple 原生 AUX 交易）完成時記下結果與 AUX/面板電源暫存器。
+// 最近 64 筆環狀 + 前 32 筆失敗固定保留。只讀 MMIO，不寫。
+static constexpr uint32_t onb4AuxRegs[16]={0x64010,0x64014,0x64018,0x6401C,0x64020,0x64024, // AUX_CH_CTL_A、DATA1..5
+ 0xC7200,0xC7204,0xC4000,0x45440,0x45444,0x45450,0x45454,0x45504,0x64000,0x46010};      // PP_STATUS/CTL、SDEISR、AUX/DDI wells、DC_STATE、DDI_BUF、DPLL0_EN
+struct ONB4AuxRec {uint64_t ns;uint32_t seq,result,command,args,header,reply,pad[2];uint32_t r[16];};
+static ONB4AuxRec onb4AuxLast[64],onb4AuxFail[32];
+static uint32_t onb4AuxCount,onb4AuxFailCount;
+static void onb4AuxRecord(void *port,uint32_t command,uint32_t args,uint32_t header,uint32_t reply,uint32_t result) {
+ auto pb=static_cast<uint8_t *>(port);if(!pb)return;
+ auto config=*reinterpret_cast<uint32_t **>(pb+0x548);if(!config || config[0]!=0)return;
+ auto a=*reinterpret_cast<uint8_t **>(pb+0x578);if(!a)return;
+ auto base=*reinterpret_cast<volatile uint8_t **>(a+0x50);
+ if(!base || *reinterpret_cast<uint32_t *>(a+0x60)<0x165000)return;
+ ONB4AuxRec rec {};
+ uint64_t t;clock_get_uptime(&t);absolutetime_to_nanoseconds(t,&rec.ns);
+ rec.result=result;rec.command=command;rec.args=args;rec.header=header;rec.reply=reply;
+ for(unsigned i=0;i<16;++i)rec.r[i]=*reinterpret_cast<volatile uint32_t *>(base+onb4AuxRegs[i]);
+ rec.seq=__sync_add_and_fetch(&onb4AuxCount,1);
+ onb4AuxLast[(rec.seq-1)%64]=rec;
+ if(result!=0) {
+  const auto f=__sync_add_and_fetch(&onb4AuxFailCount,1);
+  if(f<=32)onb4AuxFail[f-1]=rec;
+ }
+}
+static bool onb4AuxSerialize(void *,void *,OSSerialize *serializer) {
+ auto data=OSData::withCapacity(16+sizeof(onb4AuxRegs)+sizeof(onb4AuxFail)+sizeof(onb4AuxLast));if(!data)return false;
+ // header：ver, 總筆數, 失敗筆數, record 大小；接著 16 個暫存器位址、32 筆失敗、64 筆最近
+ uint32_t head[4]={1,onb4AuxCount,onb4AuxFailCount,uint32_t(sizeof(ONB4AuxRec))};
+ data->appendBytes(head,sizeof(head));data->appendBytes(onb4AuxRegs,sizeof(onb4AuxRegs));
+ data->appendBytes(onb4AuxFail,sizeof(onb4AuxFail));data->appendBytes(onb4AuxLast,sizeof(onb4AuxLast));
+ const bool ok=data->serialize(serializer);data->release();return ok;
+}
+// ⑮：AUX A 卡住的實驗開關（預設全關）。
+//  -onb4auxreset：DDI A 的 RunAUX 失敗時，把 AUX A power well 的 BIOS/driver request（0x45440/0x45444 bit1）都清掉
+//                 等 well 真的關（bit0=0）、再只用 driver request 打開，清 AUX_CTL 狀態位後重試一次（每 2 秒最多一次）。
+//  -onb4auxbios ：關面板（hwSetPanelPower(0)）時清掉 BIOS request（Linux 開機時也會清），讓 Apple 自己的 request 開關真的能關掉 well。
+//  -onb4d3      ：關面板前寫 DPCD 0x600=2（D3），開面板後寫 0x600=1（D0），同 Linux。
+static bool onb4AuxResetEnabled,onb4AuxBiosEnabled,onb4D3Enabled;
+static volatile bool onb4AuxResetting;
+static uint64_t onb4AuxResetLastNs;
+// ONB4AuxReset：count, okCount, 最近一次的 ns(lo,hi), BIOS/DRV 前值, 關後 DRV, 開後 DRV, AUX_CTL 前/後, 重試結果, 關等待 us, 開等待 us
+static uint32_t onb4AuxResetRec[13];
+static uint32_t onb4AuxBiosClears,onb4AuxBiosLast[2],onb4D3Writes[2],onb4D3Last[2];
+static volatile uint8_t *onb4MMIO(void *port) {
+ auto pb=static_cast<uint8_t *>(port);if(!pb)return nullptr;
+ auto config=*reinterpret_cast<uint32_t **>(pb+0x548);if(!config || config[0]!=0)return nullptr;
+ auto a=*reinterpret_cast<uint8_t **>(pb+0x578);if(!a)return nullptr;
+ auto base=*reinterpret_cast<volatile uint8_t **>(a+0x50);
+ if(!base || *reinterpret_cast<uint32_t *>(a+0x60)<0x165000)return nullptr;
+ return base;
+}
+static inline uint32_t onb4R(volatile uint8_t *b,uint32_t r){return *reinterpret_cast<volatile uint32_t *>(b+r);}
+static inline void onb4W(volatile uint8_t *b,uint32_t r,uint32_t v){*reinterpret_cast<volatile uint32_t *>(b+r)=v;}
+// 回傳 true = 有做 reset（呼叫端再重試一次）
+static bool onb4AuxWellCycle(void *port) {
+ auto b=onb4MMIO(port);if(!b)return false;
+ uint64_t t;clock_get_uptime(&t);uint64_t ns;absolutetime_to_nanoseconds(t,&ns);
+ if(onb4AuxResetLastNs && ns-onb4AuxResetLastNs<2000000000ULL)return false;
+ onb4AuxResetLastNs=ns;
+ auto &r=onb4AuxResetRec;
+ r[0]++;r[2]=uint32_t(ns);r[3]=uint32_t(ns>>32);
+ r[4]=onb4R(b,0x45440);r[5]=onb4R(b,0x45444);r[8]=onb4R(b,0x64010);
+ onb4W(b,0x45440,r[4]&~2U);onb4W(b,0x45444,r[5]&~2U);
+ uint32_t us=0;while((onb4R(b,0x45444)&1U) && us<20000){IODelay(50);us+=50;}
+ r[6]=onb4R(b,0x45444);r[11]=us;
+ IODelay(1000);
+ onb4W(b,0x45444,onb4R(b,0x45444)|2U);
+ us=0;while(!(onb4R(b,0x45444)&1U) && us<20000){IODelay(50);us+=50;}
+ r[7]=onb4R(b,0x45444);r[12]=us;
+ IODelay(500);
+ // AUX_CTL：清 DONE/TIMEOUT/RXERR（W1C），不設 BUSY
+ const auto ctl=onb4R(b,0x64010);onb4W(b,0x64010,(ctl&~0x80000000U)|0x52000000U);
+ r[9]=onb4R(b,0x64010);
+ return true;
+}
+static bool onb4WakeSerialize(void *,void *,OSSerialize *serializer) {
+ auto data=OSData::withCapacity(64+sizeof(onb4WakeSnaps));if(!data)return false;
+ // v10 header：16 words = ver,count,flags(bit0 HPD bit1 IREF bit2 DCC),HPD|IREF<<16,dccFixes,bootSaved,
+ //   bootTXDW8[4],bootPCSDW1[4],lane4Fixes(v11),tpsState(v12)
+ uint32_t head[16]={12,__atomic_load_n(&onb4WakeCount,__ATOMIC_ACQUIRE),
+  uint32_t(onb4HPDFixEnabled)|uint32_t(onb4IREFFixEnabled)<<1|uint32_t(onb4DCCFixEnabled)<<2|uint32_t(onb4Lane4Enabled)<<3|uint32_t(onb4TPS3Enabled)<<4,
+  onb4HPDFixes|onb4IREFFixes<<16,onb4DCCFixes,onb4BootSaved};
+ memcpy(head+6,onb4BootTXDW8,sizeof(onb4BootTXDW8));memcpy(head+10,onb4BootPCSDW1,sizeof(onb4BootPCSDW1));
+ head[14]=onb4Lane4Fixes;head[15]=onb4TPSState;
+ data->appendBytes(head,sizeof(head));data->appendBytes(onb4WakeSnaps,sizeof(onb4WakeSnaps));
+ const bool ok=data->serialize(serializer);data->release();return ok;
+}
+// ONB4 ⑰: ONB4LiveRegs —— ioreg 讀取「當下」的顯示 plane/pipe/DBUF/PSR 暫存器與 GGTT PTE（只讀，不寫任何暫存器）。
+// 用途：S3 喚醒後主 plane 整片單色（湖水綠）、游標正常、DPMS 後恢復 → 比對 湖水綠／DPMS 後／冷開機 三份。
+// 序列化時可能持有 registry 鎖 → 不睡眠；pipe 是否在跑請連讀兩次 ioreg 比 FRMCOUNT。
+// 格式 v1：u32 ver,nregs,mapSize,ptesOK；nregs×{u32 addr,u32 val}；
+//   3 組 PTE 資訊（PLANE_SURF_1_A、PLANE_SURFLIVE_1_A、CUR_BASE_A）各 {u32 gfxAddr,u32 pad,u64 pte0,u64 pteMid,u64 pteLast,u64 xorAll,u64 zeroCount}
+static constexpr uint32_t onb4LiveRegs[] {
+ 0x45008,0x44FE8,0x45038,0x45504,0x45404,0x46000,                   // DBUF_CTL_S1/S2、MBUS_ABOX_CTL、DC_STATE_EN、PWR_WELL_CTL2、CDCLK_CTL
+ 0x44400,0x44404,0x44408,0x4440C,                                   // DE_PIPE_ISR/IMR/IIR/IER A（bit31 underrun）
+ 0x44410,0x44418,                                                   // DE_PIPE_ISR/IIR B
+ 0x70008,0x70030,0x70034,0x6001C,0x70040,0x70044,0x60400,0x60000,0x6000C, // TRANSCONF_A、PIPE_MISC、BOTTOM_COLOR、PIPESRC、FRM/FLIPCOUNT、TRANS_DDI_A、HTOTAL、VTOTAL
+ 0x4A480,0x49028,0x4A400,                                           // GAMMA_MODE_A、CSC_MODE_A、PAL_PREC_INDEX_A（不讀 DATA：會動 index）
+ 0x70180,0x70188,0x7018C,0x70190,0x7019C,0x701A4,0x701AC,0x701CC,   // PLANE_1_A CTL/STRIDE/POS/SIZE/SURF/OFFSET/SURFLIVE/COLOR_CTL
+ 0x7027C,0x70240,0x70268,                                           // PLANE_BUF_CFG_1_A、PLANE_WM_1_A_0、PLANE_WM_TRANS_1_A
+ 0x70280,0x7029C,0x7037C,0x70380,                                   // PLANE_2_A CTL/SURF、BUF_CFG_2_A、PLANE_3_A CTL
+ 0x70080,0x70084,0x70088,0x700AC,0x7017C,                           // CUR_CTL/BASE/POS/SURFLIVE/BUF_CFG A
+ 0x60800,0x60840,0x60900,0x60940,                                   // PSR_CTL/STATUS、PSR2_CTL/STATUS（trans A）
+ 0x71008,0x71180,0x7119C,0x71080,0x71040,                           // pipe B：TRANSCONF、PLANE_1 CTL/SURF、CUR_CTL、FRMCOUNT
+ 0xC7200,0x64000,                                                   // PP_STATUS、DDI_BUF_CTL_A
+ 0x44050,0x44054,0x70000,0x70000,                                   // ㉑ DERRMR、DERRMR2、PIPEDSL_A ×2（看 scanline 有沒有在動）
+ 0x701C0,0x701C4};                                                  // ㉖ PLANE_AUX_DIST_1_A、PLANE_AUX_OFFSET_1_A（雪花：CCS）
+// ㉑ ONB4SyncTrace：IGAccelSurface::generateSync（submitSwapFlush 的 MI_LOAD_SCAN_LINES + MI_WAIT_FOR_EVENT）呼叫紀錄。
+// 所有 WindowServer ctx 的 GPU hang 都是 LastContextSwitchReason=WAIT_ON_SCANLINE → 確認 S3 後是否改走這條路。
+// -onb4nosync：不呼叫原函式（不發 scanline wait，最多畫面撕裂）。
+// 格式 v1：u32 ver,calls,skipped,nosync；最近 32 筆 {u64 ns,u32 wakeSnapCount,a,pipe,c,i16 x,y,w,h}（環狀，calls%32 為下一筆位置）
+struct ONB4SyncRec {uint64_t ns;uint32_t snap,a,pipe,c;int16_t b[4];};
+static volatile uint32_t onb4SyncCalls,onb4SyncSkipped;
+static bool onb4NoSync;
+static ONB4SyncRec onb4SyncRecs[32];
+static bool onb4SyncSerialize(void *,void *,OSSerialize *serializer) {
+ uint32_t head[4]={1,__atomic_load_n(&onb4SyncCalls,__ATOMIC_ACQUIRE),__atomic_load_n(&onb4SyncSkipped,__ATOMIC_ACQUIRE),onb4NoSync};
+ auto data=OSData::withCapacity(sizeof(head)+sizeof(onb4SyncRecs));if(!data)return false;
+ data->appendBytes(head,sizeof(head));data->appendBytes(onb4SyncRecs,sizeof(onb4SyncRecs));
+ const bool ok=data->serialize(serializer);data->release();return ok;
+}
+static bool onb4LiveSerialize(void *,void *,OSSerialize *serializer) {
+ constexpr uint32_t n=sizeof(onb4LiveRegs)/sizeof(onb4LiveRegs[0]);
+ auto b=onb4LiveBase;const auto size=onb4LiveSize;
+ const bool ptesOK=b && size>=0x800000+0x1000;
+ uint32_t head[4]={1,b?n:0,size,ptesOK};
+ auto data=OSData::withCapacity(sizeof(head)+n*8+3*48);if(!data)return false;
+ data->appendBytes(head,sizeof(head));
+ if(b) {
+  uint32_t surf=0,live=0,cur=0;
